# Anthony.ia · conexão com Supabase
# Copie este arquivo para .env.local e preencha.
# Onde achar: Supabase Dashboard → Project Settings → API
#
# Sem estas variáveis o app roda em modo local-first (sessão e dados
# ficam no navegador). Com elas, auth e dados passam a usar o Supabase.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
